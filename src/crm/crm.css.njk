---
permalink: crm/crm.css
eleventyExcludeFromCollections: true
---
:root{--ink:#201b18;--muted:#746b65;--paper:#f4f0e9;--white:#fff;--accent:#a74738;--line:#ded6cc;--green:#2f7d54;font-family:Inter,"Noto Sans TC",system-ui,sans-serif;color:var(--ink);background:var(--paper)}
*{box-sizing:border-box}[hidden]{display:none!important}body{margin:0}.crm-shell{min-height:100vh}.crm-header{position:sticky;top:0;z-index:5;display:flex;justify-content:space-between;align-items:center;padding:18px clamp(20px,5vw,72px);border-bottom:1px solid var(--line);background:rgba(244,240,233,.94);backdrop-filter:blur(12px)}.crm-brand{display:grid;color:inherit;text-decoration:none}.crm-brand strong{font-size:1.05rem}.crm-brand span{font-size:.72rem;color:var(--muted)}.crm-user{align-items:center;gap:14px}.crm-user button,.crm-tabs button,.crm-page-heading button,.crm-filters button{border:0;background:var(--ink);color:#fff;padding:10px 14px;font:inherit;cursor:pointer}
main{max-width:1440px;margin:auto;padding:clamp(28px,5vw,72px)}.eyebrow{margin:0 0 8px;color:var(--accent);font-size:.75rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.crm-setup,.crm-login{max-width:850px;margin:10vh auto;padding:clamp(28px,5vw,60px);border:1px solid var(--line);background:var(--white)}h1{margin:0;font-size:clamp(2rem,5vw,4rem);letter-spacing:-.04em}.crm-setup p,.crm-login p{line-height:1.8;color:var(--muted)}code{background:#eee7dd;padding:.15em .35em}.crm-login{display:grid;grid-template-columns:1.2fr .8fr;gap:48px}.crm-login form,.crm-filters label,.crm-detail-form label{display:grid;gap:8px}.crm-login input,.crm-filters input,.crm-filters select,.crm-detail input,.crm-detail select,.crm-detail textarea{width:100%;border:1px solid var(--line);background:#fff;padding:12px;font:inherit}.crm-login button{margin-top:16px;width:100%;border:0;background:var(--accent);color:#fff;padding:14px;font:inherit;font-weight:700}
.crm-tabs{display:flex;gap:4px;margin-bottom:46px;border-bottom:1px solid var(--line)}.crm-tabs button{background:transparent;color:var(--muted);border-bottom:3px solid transparent}.crm-tabs button.is-active{color:var(--ink);border-color:var(--accent)}.crm-page-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:28px}.crm-page-heading h1{font-size:clamp(2rem,4vw,3.2rem)}.crm-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.crm-metric{padding:24px;border:1px solid var(--line);background:#fff}.crm-metric span{display:block;color:var(--muted);font-size:.82rem}.crm-metric strong{display:block;margin-top:14px;font-size:2.4rem}.crm-metric.is-alert strong{color:var(--accent)}.crm-charts{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:18px}.crm-charts section{padding:26px;border:1px solid var(--line);background:#fff}.crm-charts h2{margin-top:0}.crm-bar{display:grid;grid-template-columns:minmax(100px,1fr) 3fr auto;gap:10px;align-items:center;margin:12px 0;font-size:.82rem}.crm-bar i{display:block;height:8px;background:var(--accent)}
.crm-filters{display:grid;grid-template-columns:2fr repeat(3,1fr) auto;gap:12px;align-items:end;margin-bottom:20px}.crm-table-wrap{overflow:auto;border:1px solid var(--line);background:#fff}table{width:100%;border-collapse:collapse;min-width:940px}th,td{padding:16px;text-align:left;border-bottom:1px solid #eee8e0;font-size:.88rem}th{color:var(--muted);font-size:.72rem;text-transform:uppercase;letter-spacing:.06em}tbody tr{cursor:pointer}tbody tr:hover{background:#faf7f2}.status{display:inline-block;padding:5px 8px;border-radius:999px;background:#eee7dd;font-size:.72rem;font-weight:800}.status.NEW{background:#fae5df;color:#8d3529}.status.WON{background:#e0f1e7;color:#256143}.overdue{color:var(--accent);font-weight:700}.crm-empty{text-align:center;color:var(--muted)}
.crm-detail{width:min(980px,94vw);max-height:90vh;padding:0;border:0;box-shadow:0 28px 90px rgba(20,15,12,.3)}.crm-detail::backdrop{background:rgba(20,15,12,.62)}.crm-detail-close{position:sticky;top:12px;float:right;margin:12px 12px 0 0;z-index:2;width:40px;height:40px;border:0;border-radius:50%;background:var(--ink);color:#fff;font-size:1.5rem}.crm-detail-inner{padding:clamp(24px,5vw,54px)}.crm-detail-grid{display:grid;grid-template-columns:1fr .8fr;gap:34px}.crm-detail dl{display:grid;grid-template-columns:130px 1fr;gap:10px;margin:24px 0}.crm-detail dt{color:var(--muted)}.crm-detail dd{margin:0}.crm-detail-form{display:grid;gap:14px;padding:22px;background:#f7f3ed}.crm-detail-form button,.crm-activity-form button{border:0;background:var(--accent);color:#fff;padding:12px;font:inherit}.crm-timeline{margin-top:36px}.crm-activity{padding:14px 0;border-bottom:1px solid var(--line)}.crm-activity small{color:var(--muted)}.crm-activity-form{display:grid;grid-template-columns:150px 1fr auto;gap:10px;margin-top:18px}
@media(max-width:800px){main{padding:24px 16px}.crm-login,.crm-detail-grid,.crm-charts{grid-template-columns:1fr}.crm-metrics{grid-template-columns:1fr 1fr}.crm-filters{grid-template-columns:1fr 1fr}.crm-filters label:first-child{grid-column:1/-1}.crm-filters button{grid-column:1/-1}.crm-page-heading{align-items:start;gap:16px}.crm-detail dl{grid-template-columns:1fr}.crm-activity-form{grid-template-columns:1fr}.crm-header{padding:14px 16px}}@media(max-width:480px){.crm-metrics{grid-template-columns:1fr}}
