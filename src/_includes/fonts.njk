{# Keep the existing families and weight ranges. Fetch fonts without blocking
   the first paint; system fallbacks remain available while fonts load. #}
{% set fontStylesheet = "https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400..900&family=Noto+Sans+TC:wght@400..800&display=swap" %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{ fontStylesheet | escape }}" media="print" onload="this.media='all';this.onload=null">
<noscript><link rel="stylesheet" href="{{ fontStylesheet | escape }}"></noscript>
