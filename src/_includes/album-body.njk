{#- 活動案例相簿共用版型（2026-11）。頁面需先設定 gallery = galleries["key"]。
    順序：麵包屑＋標題＋說明 → 規劃重點與行動 → 照片（點擊放大）→ 推薦方案與其他案例 → 收尾行動。
    照片網址一律經 galleryThumbnail / galleryFull / gallerySrcset，後台上傳的照片才會走自動產生的尺寸。 -#}
{%- set context = galleryContexts[gallery.key] -%}
{%- set contactHref = "/pages/contact?eventType=" + (context.eventType if context else "") + "&amp;source=gallery-" + gallery.key -%}
{%- set indexEntry = galleryIndex.byKey[gallery.key] -%}

<section class="gl-album-hero" aria-labelledby="album-title">
  <div class="gl-shell">
    <nav class="gl-crumbs reveal reveal-hero" aria-label="麵包屑">
      <ol>
        <li><a href="/">首頁</a></li>
        <li><a href="/gallery/">活動案例</a></li>
        <li aria-current="page">{{ gallery.title }}</li>
      </ol>
    </nav>
    <div class="gl-album-head reveal reveal-hero">
      <div>
        <h1 id="album-title" class="gl-title">{{ gallery.title }}</h1>
        <p class="gl-lede">{{ gallery.intro }}</p>
      </div>
      <div class="gl-album-actions">
        <a class="button button-line" href="{{ site.lineUrl }}" target="_blank" rel="noopener noreferrer" aria-label="加 LINE 洽詢相似的{{ gallery.title }}活動">LINE 洽詢相似活動</a>
        <a class="button button-secondary" href="{{ contactHref }}">填寫演出需求</a>
      </div>
    </div>
    {% if context %}
    <dl class="gl-context reveal" aria-label="{{ gallery.title }}活動規劃重點">
      <div>
        <dt>適合情境與場地條件</dt>
        <dd>{{ context.conditions }}</dd>
      </div>
      <div>
        <dt>常見演出安排</dt>
        <dd>{{ context.arrangement }}</dd>
      </div>
    </dl>
    {% endif %}
  </div>
</section>

<section class="gl-photos" aria-label="{{ gallery.title }}照片">
  <div class="gl-shell">
    <p class="gl-photo-hint">{{ gallery.photos | length }} 張現場照片・點擊可放大</p>
    <div class="gl-photo-grid">
      {% for photo in gallery.photos %}
      <button class="gl-photo" type="button" data-album-photo data-lightbox-src="{{ photo | galleryFull }}" aria-label="放大檢視：{{ photo.alt }}"><img src="{{ photo | galleryThumbnail }}" srcset="{{ photo | gallerySrcset }}" sizes="(max-width: 760px) 50vw, (max-width: 1100px) 45vw, 380px" alt="{{ photo.alt }}" {% if loop.index > 3 %}loading="lazy" {% endif %}decoding="async" width="{{ photo.width }}" height="{{ photo.height }}"></button>
      {% endfor %}
    </div>
  </div>
</section>

<section class="gl-more" aria-labelledby="gl-more-title">
  <div class="gl-shell gl-more-grid">
    <div class="reveal">
      <h2 id="gl-more-title" class="gl-section-title">其他活動案例</h2>
      {% if indexEntry and indexEntry.plan %}
      <p class="gl-plan">想了解這類活動的演出規劃，可以看
        <a href="{{ indexEntry.plan.href }}">{{ indexEntry.plan.label }}<span aria-hidden="true"> →</span></a></p>
      {% endif %}
    </div>
    <ul class="gl-more-list reveal">
      {% for entry in galleryIndex.items %}{% if entry.key != gallery.key %}
      <li><a href="/gallery/{{ entry.key }}">{{ galleries[entry.key].title }}<span aria-hidden="true">→</span></a></li>
      {% endif %}{% endfor %}
    </ul>
  </div>
</section>

<section class="gl-cta" aria-labelledby="gl-cta-title">
  <div class="gl-shell gl-cta-grid">
    <div class="reveal">
      <h2 id="gl-cta-title" class="gl-cta-title"><span class="gl-phrase">規劃類似的活動？</span><span class="gl-phrase">先告訴我們日期與地點</span></h2>
      <p>提供活動日期、地點與活動類型，我們會依場地與流程建議合適的演出內容與報價。</p>
    </div>
    <div class="gl-cta-actions reveal">
      <a class="button button-line" href="{{ site.lineUrl }}" target="_blank" rel="noopener noreferrer" aria-label="加 LINE 洽詢演出">LINE 洽詢・{{ site.lineId }}</a>
      <a class="button gl-button-ghost" href="{{ contactHref }}">線上填寫需求</a>
      <p class="gl-cta-tel">或來電 <a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a></p>
    </div>
  </div>
</section>
