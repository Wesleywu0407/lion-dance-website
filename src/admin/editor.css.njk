---
permalink: admin/editor.css
eleventyExcludeFromCollections: true
---
:root{color-scheme:light;--paper:#f5f4ef;--ink:#242d29;--muted:#6c746e;--green:#294f40;--line:#dcdfd5;--white:#fffefa}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.7 system-ui,sans-serif}a{color:var(--green);text-underline-offset:4px}button,input,textarea{font:inherit}button,a,input,textarea{touch-action:manipulation}button{cursor:pointer;background:white;border:1px solid var(--line);border-radius:6px;padding:10px 16px;color:var(--ink);min-height:44px}button:disabled{cursor:not-allowed;opacity:.5}a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #b48b43;outline-offset:3px}[hidden]{display:none!important}.studio-header{height:88px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 5vw;gap:20px;background:var(--white)}.brand{display:flex;align-items:center;gap:12px;text-decoration:none;font-size:21px;font-weight:750;white-space:nowrap}.brand-mark{background:var(--green);color:#fff;padding:1px 8px;border-radius:3px;font-family:serif}.brand-sub{font-size:14px;font-weight:400;color:var(--muted);border-left:1px solid var(--line);padding-left:12px}.studio-header nav{display:flex;align-items:center;gap:24px;font-size:13px}.welcome{max-width:1140px;margin:0 auto;min-height:calc(100vh - 88px);display:grid;grid-template-columns:1.1fr 1fr;align-items:center;gap:90px;padding:70px 32px}.eyebrow{font-size:11px;letter-spacing:.14em;font-weight:700;color:var(--green);margin:0 0 16px}.welcome h1{font-family:serif;font-size:clamp(38px,5.2vw,64px);font-weight:600;line-height:1.45;letter-spacing:.04em;margin:24px 0}.welcome-copy>p:not(.eyebrow){font-size:17px;color:var(--muted)}.welcome-tags{display:flex;gap:10px;flex-wrap:wrap;margin-top:32px}.welcome-tags span{font-size:12px;border:1px solid #cbd1c5;border-radius:30px;padding:5px 12px;color:var(--green)}.login-card{padding:40px;background:var(--white);border:1px solid var(--line);border-radius:14px;box-shadow:0 20px 60px #263d2710}.small-label{font-size:12px;color:var(--muted)}h2{font-size:26px;line-height:1.4;margin:8px 0 16px}.login-card>p{color:var(--muted);font-size:14px}.login-card form{margin-top:28px}label{display:block;font-size:14px;font-weight:650;margin:0 0 7px}input,textarea{display:block;width:100%;border:1px solid #bdc7b9;border-radius:6px;background:white;color:var(--ink);padding:12px 14px}textarea{resize:vertical;min-height:118px}input[type=search]{font-size:14px}.primary{background:var(--green);color:white;border-color:var(--green);font-weight:600}.login-card .primary{width:100%;margin-top:16px}.setup,.preview-banner{background:#e9edde;border:1px solid #d5ddc7;border-radius:6px;padding:13px 16px;font-size:13px}.preview-link{display:block;margin-top:22px;font-size:13px}.workspace{display:grid;grid-template-columns:270px minmax(0,1fr);max-width:1600px;margin:auto}.sidebar{border-right:1px solid var(--line);padding:30px 20px;background:#eeeee5;min-height:calc(100vh - 88px)}.sidebar h2{font-size:12px;color:var(--muted);margin:26px 10px 10px;font-weight:650}.entry-button{display:block;text-align:left;width:100%;border:0;background:transparent;font-size:13px;padding:10px 12px;margin:2px 0}.entry-button[aria-current=true]{background:var(--green);color:white}.editor-area{padding:32px 36px;min-width:0}.preview-banner{margin-bottom:26px}.preview-banner a{margin-left:12px}.editor-heading{display:flex;justify-content:space-between;align-items:center;gap:12px}.editor-heading h1{font-size:30px;line-height:1.3;margin:0 0 8px}.editor-heading a{font-size:13px;white-space:nowrap}.muted{color:var(--muted);font-size:12px;overflow-wrap:anywhere}.edit-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(240px,1fr);gap:26px;align-items:start}.field{margin-bottom:24px}.field small{display:block;color:var(--muted);font-size:12px;text-align:right;margin-top:5px}fieldset{border:1px solid var(--line);border-radius:8px;margin:0 0 22px;padding:18px;background:#fffefa}legend{font-weight:650;padding:0 8px}.list-item{margin-bottom:20px;padding-bottom:18px;border-bottom:1px solid var(--line)}.list-item h3{font-size:13px;color:var(--muted);margin:0 0 14px}.live-preview{background:var(--white);border:1px solid var(--line);border-radius:10px;padding:24px;position:sticky;top:22px;overflow-wrap:anywhere}.preview-url{font-size:12px;color:var(--muted);margin:0 0 12px}.live-preview h2{color:#24518a;font-size:21px;margin-top:0}.live-preview p:not(.eyebrow):not(.preview-url):not(.preview-note){font-size:14px;white-space:pre-line}.live-preview h3{font-size:16px;margin:20px 0 8px}.preview-note{color:var(--muted);border-top:1px solid var(--line);padding-top:18px;margin-top:24px;font-size:12px}.actions{position:sticky;bottom:0;display:flex;justify-content:flex-end;align-items:center;gap:12px;padding:20px 0;background:var(--paper);border-top:1px solid var(--line);margin-top:24px}.actions span{margin-right:auto;color:var(--muted);font-size:13px}#editor-status{font-size:14px;white-space:pre-line}#editor-status.error,#login-status.error{color:#9c362a}dialog{max-width:500px;width:calc(100% - 40px);padding:30px;border:1px solid var(--line);border-radius:12px;color:var(--ink);background:var(--white)}dialog::backdrop{background:#172b2466}.dialog-actions{display:flex;gap:12px;justify-content:flex-end;margin-top:26px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
@media(max-width:1050px){.welcome{gap:40px}.workspace{grid-template-columns:225px minmax(0,1fr)}.editor-area{padding:28px 24px}.edit-grid{grid-template-columns:1fr}.live-preview{position:static}}
@media(max-width:640px){.studio-header{height:auto;min-height:76px;padding:16px 20px;flex-wrap:wrap;gap:12px}.brand{font-size:18px}.studio-header nav{gap:18px}.welcome{padding:36px 20px;grid-template-columns:1fr;gap:30px}.welcome h1{font-size:40px;margin:14px 0}.welcome-copy>p:not(.eyebrow){font-size:15px}.welcome-tags{margin-top:20px}.login-card{padding:26px}.workspace{grid-template-columns:1fr}.sidebar{min-height:0;border-right:0;border-bottom:1px solid var(--line);padding:20px}#entry-list{max-height:210px;overflow:auto}.editor-area{padding:24px 20px}.editor-heading{align-items:flex-start;flex-direction:column}.editor-heading h1{font-size:26px}.actions{gap:8px;flex-wrap:wrap}.actions span{width:100%;margin:0}.actions button{flex:1}fieldset{padding:14px}.live-preview{padding:20px}}

.password-label{margin-top:18px}.password-help{font-size:12px;color:var(--muted);margin:10px 0 0}

.workspace{max-width:1700px;grid-template-columns:300px minmax(0,1fr);background:#f7f8fa}
.workspace .eyebrow{letter-spacing:0}.sidebar{background:#fff;position:sticky;top:0;height:100vh;min-height:0;display:flex;flex-direction:column;padding:24px 16px}
.sidebar-search{padding:0 8px 8px;flex:none}.sidebar-search label{font-size:16px}.search-control{position:relative}.search-control input{padding-right:44px;border-color:#c8cdd2}.search-control input::-webkit-search-cancel-button{display:none}
#clear-search{position:absolute;right:2px;top:2px;width:40px;height:40px;min-height:40px;padding:0;font-size:22px;border:0;background:transparent}
#search-count{font-size:12px;color:var(--muted);margin:8px 0 0;min-height:21px}#entry-list{overflow:auto;min-height:0;overscroll-behavior:contain}.sidebar h2{margin:18px 12px 6px;letter-spacing:0}
.page-button{display:flex;flex-direction:column;gap:2px;min-height:62px;line-height:1.5}.page-button>span{font-size:15px;font-weight:600}.page-button>small{font-size:11px;color:var(--muted)}.page-button[aria-current=true]>small{color:#dfece5}
.entry-button{overflow-wrap:anywhere}.entry-button:hover:not([aria-current=true]){background:#eff2f5}.search-result{padding:8px 0;border-bottom:1px solid var(--line)}.search-result>.entry-button{font-weight:650}.match-button{display:block;width:100%;text-align:left;border:0;border-radius:4px;padding:10px 12px;background:transparent;line-height:1.5;overflow-wrap:anywhere}.match-button:hover,.match-button:focus-visible{background:#edf3fa}.match-button strong{display:block;font-size:12px;color:#315c83;font-weight:600;margin-bottom:3px}.match-button span{display:block;font-size:13px;color:#4f5962}.empty-results{font-size:14px;padding:12px;color:var(--muted)}
.editor-heading h1{font-size:28px}.entry-sections{display:flex;flex-wrap:wrap;gap:0;border-bottom:1px solid #d4d9de;margin-top:18px}.entry-sections button{border:0;border-bottom:3px solid transparent;border-radius:0;background:transparent;font-size:14px;padding:12px 16px;max-width:100%;overflow-wrap:anywhere}.entry-sections button[aria-pressed=true]{border-color:var(--green);color:var(--green);font-weight:700;background:#eaf0ec}.scope-note{font-size:13px;color:#5b6370;background:#edf1f6;border-left:3px solid #7994b1;padding:10px 14px;margin:16px 0}
.field-toolbar{display:flex;align-items:center;gap:16px;margin:22px 0}.field-toolbar label{margin:0;flex:none;font-size:13px}.field-toolbar select{font:inherit;font-size:13px;padding:10px 32px 10px 12px;min-height:44px;min-width:0;max-width:100%;width:100%;background:#fff;border:1px solid #c8cdd2;border-radius:6px;color:var(--ink)}select:focus-visible{outline:3px solid #b48b43;outline-offset:3px}.field.located>input,.field.located>textarea{outline:3px solid #ca943d;outline-offset:3px;background:#fffbed}.field input,.field textarea{scroll-margin:100px 0}.live-preview{border-radius:8px}.workspace .actions{background:#f7f8fa}.field label,legend{overflow-wrap:anywhere}.field{min-width:0}.workspace fieldset{background:transparent;border-width:0;border-top:1px solid var(--line);border-radius:0;padding:18px 0}.workspace fieldset legend{padding-left:0}.field-toolbar select{text-overflow:ellipsis}
.workspace .list-item h3{font-size:15px;color:var(--green);line-height:1.6;padding:8px 0;overflow-wrap:anywhere}.editor-heading h1{scroll-margin-top:24px}
#back-to-search{display:none}
@media(min-width:1051px){.edit-grid{grid-template-columns:minmax(0,1.4fr) minmax(230px,1fr)}}
@media(max-width:1050px){.workspace{grid-template-columns:260px minmax(0,1fr)}}
@media(max-width:640px){.workspace{grid-template-columns:1fr}.sidebar{position:static;height:auto;padding:18px 12px}.sidebar-search{padding-bottom:0}#entry-list{max-height:230px;margin-top:4px}.sidebar h2{margin-top:12px}.editor-heading h1{font-size:24px}.entry-sections button{padding:10px 12px;font-size:13px}.field-toolbar{gap:10px}.editor-area{padding:22px 20px}.scope-note{font-size:12px}#back-to-search{display:block}.actions button{padding:10px 8px;font-size:13px}}
